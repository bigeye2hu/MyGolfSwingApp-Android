# Android launch external evidence template.
#
# Copy this file to a dated private evidence folder, fill every value, then run:
# scripts/android_check_launch_evidence.sh path/to/android-launch-evidence.env
#
# Values may be plain strings or quoted strings. The checker rejects
# secret-looking values, and scans text-like local evidence files, for keystore
# passwords, private keys, bearer tokens, API keys, and secret/password
# assignments. For purchases, record a Google Play order id or the existing
# app-safe token suffix only.
# File evidence paths may be absolute, relative to this evidence file's folder,
# or relative to the Android repo root. Text proof files are read for the same
# keyword/release checks as inline values; screenshots or other binary proof
# should be paired with the metadata fields below. Fields with semantic keyword
# checks must be inline text or a non-empty text evidence file; binary proof
# alone is not accepted for those fields.

# Build artifact gate
RELEASE_BRANCH=
RELEASE_COMMIT=
RELEASE_DIRTY_FILES=
RELEASE_APPLICATION_ID=
RELEASE_VERSION_CODE=
RELEASE_VERSION_NAME=
RELEASE_TARGET_SDK=
RELEASE_APK_PATH=
RELEASE_APK_SHA256=
# RELEASE_AAB_PATH must point to the signed bundle; the evidence tools require
# META-INF/*.SF plus META-INF/*.RSA|DSA|EC signature files, jarsigner verification,
# and the signer certificate SHA-256 printed by the preflight log.
RELEASE_AAB_PATH=
RELEASE_AAB_SHA256=
RELEASE_AAB_SIGNER_SHA256=
RELEASE_PREFLIGHT_LOG=
RELEASE_PREFLIGHT_SIGNED_CHECK=
RELEASE_PREFLIGHT_MANIFEST_CHECK=
RELEASE_PREFLIGHT_DEBUG_RESOURCE_CHECK=
# True only when release lint contains no warning ids outside the freshness allowlist.
RELEASE_PREFLIGHT_LINT_WARNING_CHECK=
RELEASE_LINT_WARNING_COUNT=

# Play Console gate
# PLAY_UPLOAD_TRACK must be one of internal-testing, closed-testing,
# open-testing, or production. PLAY_INSTALL_TESTER_ACCOUNT must be the
# email-like account that installed the exact Play build.
# PLAY_SIGNING_SETUP_EVIDENCE must mention RELEASE_APPLICATION_ID, Play App
# Signing, upload key registration, and the exact RELEASE_AAB_SIGNER_SHA256
# certificate fingerprint from the signed bundle.
# PLAY_LATEST_VERSION_CODE_BEFORE_UPLOAD is the highest versionCode already
# present in Play Console before uploading this candidate; use 0 only for the
# first-ever Play upload. RELEASE_VERSION_CODE must be greater than it.
# PLAY_UPLOAD_RELEASE_ID must be a traceable Play release/version/track
# reference with a number, not generic ok/pass text.
# PLAY_RELEASE_NOTES_EVIDENCE must mention RELEASE_VERSION_NAME.
# PLAY_UPLOAD_METADATA_EVIDENCE must mention RELEASE_APPLICATION_ID,
# RELEASE_VERSION_CODE, RELEASE_VERSION_NAME, RELEASE_TARGET_SDK,
# PLAY_UPLOAD_TRACK, and PLAY_UPLOAD_RELEASE_ID from the Play upload screen
# or a release-manager note tied to that screen.
# PLAY_UPLOAD_EVIDENCE must point to an independent non-empty Play Console
# proof file; do not reuse the release APK/AAB or preflight log as evidence.
# If this proof is a text file, it must mention the app id, versionCode,
# versionName, track, and release id for this exact upload.
# PLAY_INTERNAL_INSTALL_EVIDENCE must mention PLAY_INSTALL_TESTER_ACCOUNT,
# RELEASE_APPLICATION_ID, RELEASE_VERSION_CODE, RELEASE_VERSION_NAME,
# PLAY_UPLOAD_TRACK, and install/open proof for the Play build.
PLAY_APP_SIGNING_ENABLED=
PLAY_UPLOAD_KEY_REGISTERED=
PLAY_SIGNING_SETUP_EVIDENCE=
PLAY_LATEST_VERSION_CODE_BEFORE_UPLOAD=
PLAY_UPLOAD_TRACK=
PLAY_UPLOAD_RELEASE_ID=
PLAY_RELEASE_NOTES_EVIDENCE=
PLAY_UPLOAD_METADATA_EVIDENCE=
PLAY_UPLOAD_EVIDENCE=
PLAY_INTERNAL_INSTALL_TESTED=
PLAY_INTERNAL_INSTALL_EVIDENCE=
PLAY_INSTALL_TESTER_ACCOUNT=

# Billing gate
# The checker requires BILLING_SUCCESS_BALANCE_AFTER - BILLING_SUCCESS_BALANCE_BEFORE
# to match the purchased product's credit amount: 100, 300, or 1000.
# BILLING_BACKEND_VALIDATION_POLICY must describe server-side Google Play
# purchase-token validation before credit grant, including package/app id,
# product id, and purchased/paid state matching. BILLING_BACKEND_IDEMPOTENCY_EVIDENCE
# must describe duplicate/replay handling and no-duplicate credit grant
# outcome for the same purchase/order grant.
# BILLING_SUCCESS_ORDER_LABEL must be a Google Play GPA order id or the
# app-safe purchase-token suffix label shown by the Android purchase screen.
# BILLING_SUCCESS_SERVER_GRANT_LOG must be a traceable server grant log/request
# reference with a number, not generic ok/pass text.
# BILLING_SUCCESS_GRANT_PAYLOAD_EVIDENCE must mention product id, purchase
# token, package name, quantity, google_play platform, transaction id, and
# amount without pasting the raw full token.
# BILLING_CONSUMED_EVIDENCE must show consume after successful grant.
# BILLING_RESTORE_EVIDENCE must show restoring an unconsumed/interrupted
# purchase. BILLING_CANCEL_EVIDENCE must show user-cancel handling.
# BILLING_FAILURE_COPY_EVIDENCE must cover product-unavailable, grant-failure,
# consume-failure, and release-safe/raw-hidden copy.
# BILLING_PRODUCTS_CONSOLE_EVIDENCE must mention all three product ids,
# active/available status, and price/localized amount status. BILLING_PRICES_LOADED_EVIDENCE
# must mention Google Play Billing/localized prices for the 100, 300, and 1000 tiers.
BILLING_PRODUCT_100_ACTIVE=
BILLING_PRODUCT_300_ACTIVE=
BILLING_PRODUCT_1000_ACTIVE=
BILLING_PRODUCTS_CONSOLE_EVIDENCE=
BILLING_PRICES_LOADED_EVIDENCE=
BILLING_LOGIN_GATE_EVIDENCE=
BILLING_SUCCESS_PRODUCT_ID=
BILLING_SUCCESS_ORDER_LABEL=
BILLING_SUCCESS_SERVER_GRANT_LOG=
BILLING_SUCCESS_BALANCE_BEFORE=
BILLING_SUCCESS_BALANCE_AFTER=
BILLING_SUCCESS_GRANT_PAYLOAD_EVIDENCE=
BILLING_CONSUMED_EVIDENCE=
BILLING_RESTORE_EVIDENCE=
BILLING_CANCEL_EVIDENCE=
BILLING_FAILURE_COPY_EVIDENCE=
BILLING_BACKEND_VALIDATION_POLICY=
BILLING_BACKEND_IDEMPOTENCY_EVIDENCE=

# Device QA gate
# DEVICE_ANDROID12_PLUS must mention Android 12+ or API 31+.
# DEVICE_ANDROID14_PLUS must mention Android 14+ or API 34+.
# DEVICE_QA_MATRIX_EVIDENCE must describe an Android 12/API 31 and Android
# 14/API 34 device matrix with pass/fail notes for camera, gallery, GolfCam
# export, Billing, login continuation, and Plaza cloud actions.
# QA_*_EVIDENCE values must mention the scenario-specific action being tested,
# not just generic ok/pass text.
# QA_LOGIN_CONTINUATION_EVIDENCE must cover fresh install, SMS login, password
# login, and returning to the original gated destination.
# QA_CAMERA_PERMISSION_EVIDENCE must cover denial, permanent-denial/settings
# recovery, swing recording, and video-Memo camera capture.
# QA_SWING_RECORDING_EVIDENCE must cover saving a local clip and opening replay
# analysis.
# QA_GOLFCAM_EXPORT_EVIDENCE must cover video import, workflow completion,
# preview, export, and gallery/MediaStore result.
# QA_VIDEO_MEMO_SOURCES_EVIDENCE must cover local, camera, and online sources.
# QA_PLAZA_CLOUD_EVIDENCE must cover feed load, player open, logged-in
# save/favorite/comment actions, and logged-out login gating.
# QA_LOW_CREDIT_BILLING_CONTINUATION_EVIDENCE must cover low-credit online
# download, purchase path, successful credit grant, and returning to continue.
# QA_PROFILE_KEYBOARD_EVIDENCE must cover avatar update, QR image save,
# feedback submission, account security, and keyboard/navigation reachability.
DEVICE_ANDROID12_PLUS=
DEVICE_ANDROID14_PLUS=
DEVICE_QA_MATRIX_EVIDENCE=
QA_LOGIN_CONTINUATION_EVIDENCE=
QA_CAMERA_PERMISSION_EVIDENCE=
QA_SWING_RECORDING_EVIDENCE=
QA_HOME_ANALYSIS_SOURCE_EVIDENCE=
QA_GOLFCAM_EXPORT_EVIDENCE=
QA_VIDEO_MEMO_SOURCES_EVIDENCE=
QA_PLAZA_CLOUD_EVIDENCE=
QA_LOW_CREDIT_BILLING_CONTINUATION_EVIDENCE=
QA_PROFILE_KEYBOARD_EVIDENCE=
